NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmdh_intranet
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_ACCESS_EXPIRATION=10m
JWT_REFRESH_EXPIRATION=7d

LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=10M
LOG_APP_RETENTION_DAYS=30
LOG_ERROR_RETENTION_DAYS=90
LOG_BODY=true

ALLOW_SEED=false
SEED_DEFAULT_PASSWORD=
